    "events":{

        "minecraft:entity_born": {
            "trigger": "minecraft:as_baby"
        },
      
        "minecraft:as_adult": {
            "add": {
                "component_groups": [
                    "minecraft:zombie_gelid_adult",
                    "minecraft:look_to_start_zombie_transformation"
                ]
            }
        },

        "minecraft:stop_transforming": {
            "add": {
                "component_groups": [
                    "minecraft:look_to_start_zombie_transformation"
                ]
            },
            "remove": {
                "component_groups": [
                    "minecraft:start_zombie_transformation"
                ]
            }
        },

        "minecraft:as_baby_jockey": {
            "add": {
                "component_groups": [
                    "minecraft:zombie_gelid_baby",
                    "minecraft:zombie_gelid_jockey",
                    "minecraft:look_to_start_zombie_transformation"
                ]
            }
        },

        "minecraft:as_baby": {
            "add": {
                "component_groups": [
                    "minecraft:zombie_gelid_baby",
                    "minecraft:look_to_start_zombie_transformation"
                ]
            }
        },

        "minecraft:convert_to_zombie": {
            "sequence": [
            {
                "filters": {
                    "test": "has_component",
                    "operator": "not",
                    "value": "minecraft:is_baby"
                },
                "add": {
                    "component_groups": [
                        "minecraft:convert_to_zombie"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "minecraft:start_zombie_transformation"
                    ]
                }
            },
            {
                "filters": {
                    "test": "has_component",
                    "value": "minecraft:is_baby"
                },
                "add": {
                    "component_groups": [
                        "minecraft:convert_to_baby_zombie"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "minecraft:start_zombie_transformation"
                    ]
                }
            }
            ]
        },

        "minecraft:entity_spawned": {
            "sequence": [
            {
                "randomize": [
                {
                    "trigger": "minecraft:as_adult",
                    "weight": 9500
                },
                {
                    "trigger": "minecraft:as_baby",
                    "weight": 425
                },
                {
                    "trigger": "minecraft:as_baby_jockey",
                    "weight": 75
                }
                ]
            },
            {
                "randomize": [
                {
                    "add": {
                    "component_groups": [
                        "minecraft:can_break_doors"
                    ]
                    },
                    "weight": 10
                },
                {
                    "weight": 90
                }
                ]
            }
            ]
        },

        "minecraft:start_transforming": {
            "add": {
            "component_groups": [
                "minecraft:start_zombie_transformation"
            ]
            },
            "remove": {
            "component_groups": [
                "minecraft:look_to_start_zombie_transformation"
            ]
            }
        }
