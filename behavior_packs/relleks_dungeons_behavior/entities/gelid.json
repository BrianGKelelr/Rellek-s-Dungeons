        "minecraft:convert_to_baby_zombie": {
            "minecraft:is_shaking": {},
            "minecraft:transformation": {
            "delay": {
                "value": 15
            },
            "drop_equipment": true,
            "into": "minecraft:zombie<minecraft:as_baby>",
            "transformation_sound": "mob.husk.convert_to_zombie"
            }
        },

        "minecraft:zombie_gelid_adult": {
            "minecraft:behavior.mount_pathing": {
                "priority": 2,
                "target_dist": 0,
                "speed_multiplier": 1.25,
                "track_target": true
            },
            "minecraft:experience_reward": {
                "on_death": {
                    "expression": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0",
                    "version": 13
                }
            },
            "minecraft:movement": {
                "value": 0.23
            },
            "minecraft:rideable": {
                "family_types": [
                    "baby_undead"
                ],
                "seat_count": 1,
                "seats": {
                    "lock_rider_rotation": 0,
                    "position": [
                    0,
                    1.175,
                    -0.35
                    ]
                }
            },
                "minecraft:collision_box": {
                "height": 1.9,
                "width": 0.6
            }
        },

        "minecraft:convert_to_zombie": {
            "minecraft:is_shaking": {},
            "minecraft:transformation": {
            "delay": {
                "value": 15
            },
            "drop_equipment": true,
            "into": "minecraft:zombie<minecraft:as_adult>",
            "transformation_sound": "mob.husk.convert_to_zombie"
            }
        },

        "minecraft:look_to_start_zombie_transformation": {
            "minecraft:environment_sensor": {
                "triggers": [
                    {
                        "event": "minecraft:start_transforming",
                        "filters": {
                            "test": "is_underwater"
                        }
                    }
                ]
            }
        },

        "minecraft:start_zombie_transformation": {
            "minecraft:environment_sensor": {
                "triggers": [
                    {
                        "event": "minecraft:stop_transforming",
                        "filters": {
                            "test": "is_underwater",
                            "value": false
                        }
                    }
                ]
            },
            "minecraft:timer": {
                "looping": false,
                "time": 30,
                "time_down_event": {
                    "event": "minecraft:convert_to_zombie"
                }
            }
        },

        "minecraft:zombie_gelid_baby": {
            "minecraft:experience_reward": {
                "on_death": {
                    "expression": "query.last_hit_by_player ? 12 + (query.equipment_count * Math.Random(1,3)) : 0",
                    "version": 13
                }
            },
