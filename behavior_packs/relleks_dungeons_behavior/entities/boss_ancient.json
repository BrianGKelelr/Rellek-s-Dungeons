{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "relleks_dungeons:boss_ancient",
      "is_summonable": true,
      "is_spawnable": true
    },
    "components": {
        "minecraft:behavior.float": {
        "priority": 1
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.look_at_player": {
        "look_time": {
          "min": 1,
          "max": 2
        },
        "look_distance": 16,
        "priority": 5
      },
       "minecraft:behavior.nearest_attackable_target": {
        "must_see": true,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player" },
                { "test": "is_family", "subject": "other", "value": "snowgolem" },
                { "test": "is_family", "subject": "other", "value": "irongolem" }
              ]
            },
            "max_dist": 40
          }
        ],
        "priority": 2
      },
      "minecraft:collision_box": {  //change this
        "height": 1.9,
        "width": 0.6
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 100 : 75"
      },
      "minecraft:health": {
        "max": 150,
        "value": 150
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": {
              "operator": "==",
              "test": "in_lava",
              "subject": "self",
              "value": true
            }
          }
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:jump.static": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/witch.json"  //change this
      },
      "minecraft:movement": {
        "value": 0.35
      },
      "minecraft:knockback_resistance": {
        "value": 0.8
      },
      "minecraft:can_climb": {},
      "minecraft:movement.basic": {},
      "minecraft:nameable": {},
      "minecraft:navigation.climb": {
        "can_path_over_water": true
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:renders_when_invisible": {},
      "minecraft:persistent": {},
      "minecraft:behavior.move_around_target": {
        "destination_pos_spread_degrees": 360,
        "destination_position_range": {
          "range_min": 0,
          "range_max": 12.0
        },
        "priority": 3,
        "filters": {
          "all_of": [
            {
              "test": "on_ground",
              "value": true
            },
            {
              "operator": "<=",
              "test": "target_distance",
              "subject": "self",
              "value": 24.0
            }
          ]
        },
        "height_difference_limit": 0,
        "movement_speed": 1.2
      },
      "minecraft:type_family": {
        "family": [
          "spider",
          "monster",
          "mob",
          "undead",
          "arthropod"
        ]
      }
    },
    "component_groups": {
      "melee_mode": {
        "minecraft:attack": {
          "damage": 4,
          "effect_duration": 10,
          "effect_name": "poison"
        },
        "minecraft:behavior.melee_box_attack": {
          "priority": 3
        }
      },
      "mode_switcher": {
        "minecraft:target_nearby_sensor": {
          "on_inside_range": {
            "event": "switch_to_melee",
            "target": "self"
          },
          "inside_range": 3.0,
          "must_see": true,
          "outside_range": 5.0,
          "on_outside_range": {
            "event": "switch_to_ranged",
            "target": "self"
          }
        }
      },
      "ranged_mode": {
        "minecraft:behavior.ranged_attack": {
          "priority": 3,
          "attack_interval_min": 1.0,
          "attack_interval_max": 1.0,
          "attack_radius": 28.0,
          "burst_interval": 0.01,
          "burst_shots": 3,
          "charge_shoot_trigger": 0.5
        },
        "minecraft:shooter": {
          "def": "minecraft:arrow"
        }
      }
    },
    "events": {
      "switch_to_melee": {
        "add": {
          "component_groups": [
            "melee_mode"
          ]
        },
        "remove": {
          "component_groups": [
            "ranged_mode"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "mode_switcher",
            "ranged_mode"
          ]
        }
      },
      "minecraft:on_hurt_event": {
        "add": {
          "component_groups": [
            "mode_switcher"
          ]
        }
      },
      "switch_to_ranged": {
        "add": {
          "component_groups": [
            "ranged_mode"
          ]
        },
        "remove": {
          "component_groups": [
            "melee_mode"
          ]
        }
      }
    }
  }
}


